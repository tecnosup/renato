rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Preferências de cada usuário (ex: atalhos da navbar, tema, fundo)
    match /userPreferences/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Funcionários (barbeiros). A landing precisa LER a lista para montar o
    // seletor de profissional no agendamento, então leitura é pública. Só o
    // admin logado pode criar/editar/excluir.
    match /barbers/{id} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // Serviços (catálogo). A landing precisa LER para montar o passo de
    // seleção no agendamento e a vitrine, então leitura é pública. Só o admin
    // logado com permissão gerenciarCadastros pode criar/editar/excluir.
    match /services/{id} {
      allow read: if true;
      allow create, update, delete: if canManageCadastros();
    }

    // Produtos (cosméticos). Vitrine pública na landing -> leitura aberta.
    // Escrita restrita a gerenciarCadastros. A integração com comandas
    // (debitar estoque na venda) será feita pelo lado admin/Vitor.
    match /products/{id} {
      allow read: if true;
      allow create, update, delete: if canManageCadastros();
    }

    // Categorias (de serviço e de produto). A landing agrupa o catálogo por
    // categoria -> leitura pública. Escrita restrita a gerenciarCadastros.
    match /categories/{id} {
      allow read: if true;
      allow create, update, delete: if canManageCadastros();
    }

    function canManageCadastros() {
      return request.auth != null
        && (!('perms' in request.auth.token) || request.auth.token.perms.gerenciarCadastros == true);
    }

    // Agendamentos.
    // - CREATE: landing anônima pode, com os campos esperados e status "pendente".
    // - READ: quem pode ver a agenda de todos (owner sem claims, ou perms
    //   .verAgendaTodos) lê qualquer um; barbeiro restrito só lê os DELE
    //   (barberId == uid). Em queries (onSnapshot), o cliente DEVE filtrar por
    //   barberId — a regra valida cada doc, então uma query sem filtro é negada.
    // - UPDATE/DELETE: só quem vê todos (gestão). Barbeiro não edita agenda.
    match /appointments/{id} {
      allow create: if isValidNewAppointment();
      allow read: if canSeeAllAgenda() || ownsAppointment();
      allow update, delete: if canSeeAllAgenda();
    }

    // Owner = logado sem custom claims de perms. Demais: checa o claim.
    function canSeeAllAgenda() {
      return request.auth != null
        && (!('perms' in request.auth.token) || request.auth.token.perms.verAgendaTodos == true);
    }

    function ownsAppointment() {
      return request.auth != null
        && 'barberId' in request.auth.token
        && resource.data.barberId == request.auth.token.barberId;
    }

    // Grade semanal de cada barbeiro.
    // - READ: público (landing precisa para calcular slots disponíveis via server).
    // - WRITE: só logado com permissão gerenciarGrade (owner raiz ou claim true).
    match /schedules/{barberId} {
      allow read: if true;
      allow write: if canManageSchedule(barberId);
    }

    // Bloqueios pontuais de slots.
    // - READ: público (endpoint server-side usa Admin SDK, mas regra permissiva
    //   evita erros caso haja leitura client-side futura).
    // - CREATE/DELETE: logado com permissão gerenciarGrade para o próprio barbeiro
    //   (owner raiz pode qualquer um).
    match /blockedSlots/{id} {
      allow read: if true;
      allow create: if canManageSchedule(request.resource.data.barberId);
      allow delete: if canManageSchedule(resource.data.barberId);
    }

    // Lista de espera. Operação interna do balcão — só admin logado lê/escreve.
    match /waitlist/{id} {
      allow read, create, delete: if request.auth != null;
    }

    function canManageSchedule(targetBarberId) {
      return request.auth != null
        && (!('perms' in request.auth.token)
            || (request.auth.token.perms.gerenciarGrade == true
                && (request.auth.token.barberId == targetBarberId
                    || request.auth.token.perms.verAgendaTodos == true)));
    }

    function isValidNewAppointment() {
      let d = request.resource.data;
      return d.status == "pendente"
        && d.origin in ["landing", "admin"]
        && d.date is string
        && d.time is string
        && d.serviceId is string
        && d.serviceName is string
        && d.servicePrice is number
        && d.barberId is string
        && d.barberName is string
        && d.customerName is string
        && d.customerName.size() > 0
        && d.customerPhone is string;
    }
  }
}
