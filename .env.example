# ─────────────────────────────────────────────────────────────────────────────
# Copie este arquivo para `.env.local` e preencha os valores.
# NUNCA commite o `.env.local` nem cole o conteúdo dele em chat/WhatsApp/Discord.
# ─────────────────────────────────────────────────────────────────────────────

# Config pública do Firebase (Web App).
# Onde pegar: console.firebase.google.com → ⚙ Configurações do projeto →
# aba "Geral" → seção "Seus apps" → SDK do Firebase (config). São públicas
# (vão no bundle do site), pode copiar à vontade.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Service Account do Firebase Admin SDK (PRIVADA — acesso total ao banco).
# JSON em LINHA ÚNICA, entre aspas simples.
# Onde pegar: console → ⚙ Configurações do projeto → aba "Contas de serviço" →
# "Gerar nova chave privada" → baixa um .json. NÃO cole o conteúdo no chat:
# peça ao Claude para injetar o arquivo baixado no .env.local automaticamente.
# Cada dev deve gerar a SUA própria chave (dá para revogar individualmente).
FIREBASE_SERVICE_ACCOUNT=

# Cloudflare R2 (armazenamento de imagens — ex: foto do barbeiro). Opcional por
# enquanto; só necessário quando o upload de imagens entrar em uso.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# NEXT_PUBLIC_R2_PUBLIC_URL=
