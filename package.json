{
  "name": "renato",
  "version": "0.1.0",
  "private": true,
  "//browserslist": "O padrão do Next 16 é Safari 16.4+/Chrome 111+. O iPhone 7 para no iOS 15 e Androids antigos travam em Chrome antigo — nesse alvo o bundle usa sintaxe que o aparelho não sabe ler e a página fica em branco. Baixar o alvo faz o SWC transpilar para essas versões. Ver docs/compatibilidade.md.",
  "browserslist": [
    "chrome >= 88",
    "edge >= 88",
    "firefox >= 88",
    "safari >= 14",
    "ios_saf >= 14",
    "samsung >= 13",
    "not dead"
  ],
  "scripts": {
    "dev": "cross-env NODE_USE_SYSTEM_CA=1 next dev",
    "build": "cross-env NODE_USE_SYSTEM_CA=1 next build",
    "start": "cross-env NODE_USE_SYSTEM_CA=1 next start",
    "lint": "eslint",
    "rules:deploy": "node scripts/deploy-rules.mjs",
    "rules:check": "node scripts/deploy-rules.mjs --check"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1066.0",
    "firebase": "^12.14.0",
    "firebase-admin": "^14.0.0",
    "framer-motion": "^12.40.0",
    "jose": "^6.2.3",
    "lenis": "^1.3.23",
    "lucide-react": "^1.17.0",
    "motion": "^12.40.0",
    "next": "16.2.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "^5.6.0",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
